@media (max-width: 1023px) { main > section.hero--form .hero-split { row-gap: var(--s-7); } .hero--form .hero-visual { margin-top: 0; } }
@media (max-width: 639px) { .form--card { padding: var(--s-5); } }

/* ------------------------------------------------------------ developer code sample: wraps, never cut */
