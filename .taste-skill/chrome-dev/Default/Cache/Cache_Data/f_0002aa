.doc-meta { color: var(--muted); }
.legal .doc h1 { margin-bottom: var(--s-4); }

/* ------------------------------------------------------------ contact: the hero grows with its form */
.contact-list { display: grid; gap: var(--s-5); }
.contact-list dt { font-size: var(--t-label); font-weight: 500; color: var(--muted); }
.contact-list dd { margin: var(--s-1) 0 0; font: var(--display-weight) var(--t-h3)/1.25 var(--font-display); letter-spacing: var(--display-tracking); color: var(--head); overflow-wrap: anywhere; }
.contact-list a { color: inherit; text-decoration: none; }
main > section.hero--form { height: auto; min-height: 100svh; padding-bottom: var(--s-9); }
main > section.hero.hero--form > .wrap, main > section.hero.hero--form > .wrap > .hero-text { height: auto; min-height: auto; }
main > section.hero.hero--form .hero-visual { flex: none; height: auto; min-height: 0; }
.hero--form .hero-copy { align-self: start; }
.form--card { display: grid; gap: var(--s-4); padding: var(--s-6); background: #ffffff; box-shadow: 0 1px 2px rgba(30, 39, 98, .05); }
.form select, .form input, .form textarea { width: 100%; }
.form textarea { min-height: 120px; resize: vertical; }
