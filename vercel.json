{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build/build.mjs",
  "outputDirectory": "site",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/resources",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/resources/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/developer",
      "destination": "/platform/",
      "permanent": true
    },
    {
      "source": "/developer/",
      "destination": "/platform/",
      "permanent": true
    }
  ]
}
